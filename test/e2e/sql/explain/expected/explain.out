CREATE TABLE t_ex (a int, b double, c varchar(10));
CREATE
-- 计划树: 投影/过滤/扫描
EXPLAIN SELECT a, b FROM t_ex WHERE a > 1 AND b IS NOT NULL;
                 QUERY PLAN
---------------------------------------------
 Project
   Output: a, b
   ->  Filter: ((a > 1) AND (b IS NOT NULL))
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN SELECT * FROM t_ex;
          QUERY PLAN
-------------------------------
 Project
   Output: a, b, c
   ->  Seq Scan on public.t_ex
(3 行)
-- DML 计划: 有 WHERE 与无 WHERE 的形态
EXPLAIN DELETE FROM t_ex WHERE a = 1;
             QUERY PLAN
-------------------------------------
 Delete on public.t_ex
   ->  Filter: (a = 1)
         ->  Seq Scan on public.t_ex
(3 行)
EXPLAIN DELETE FROM t_ex;
      QUERY PLAN
-----------------------
 Delete on public.t_ex
(1 行)
EXPLAIN UPDATE t_ex SET b = b + 1.5 WHERE a > 0;
             QUERY PLAN
-------------------------------------
 Update on public.t_ex
   Set: b = (b + 1.5)
   ->  Filter: (a > 0)
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN INSERT INTO t_ex VALUES (1, 1.5, 'x');
      QUERY PLAN
-----------------------
 Insert on public.t_ex
(1 行)
-- DDL 计划
EXPLAIN CREATE INDEX idx_ex ON t_ex (a);
               QUERY PLAN
----------------------------------------
 Create Index idx_ex on public.t_ex (a)
(1 行)
EXPLAIN DROP INDEX idx_ex ON t_ex;
            QUERY PLAN
----------------------------------
 Drop Index idx_ex on public.t_ex
(1 行)
-- 嵌套 explain
EXPLAIN EXPLAIN SELECT a FROM t_ex;
             QUERY PLAN
-------------------------------------
 Explain
   ->  Project
         Output: a
         ->  Seq Scan on public.t_ex
(4 行)
-- 静态校验与真实执行同文案
EXPLAIN SELECT no_col FROM t_ex;
ERROR: 列不存在: no_col
EXPLAIN SELECT a FROM t_missing;
ERROR: 表不存在: public.t_missing
-- 常量折叠: 纯常量子树在计划期求值, 折叠期常量运算错误当场报错
EXPLAIN SELECT a FROM t_ex WHERE a = 1 + 1;
             QUERY PLAN
-------------------------------------
 Project
   Output: a
   ->  Filter: (a = 2)
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN UPDATE t_ex SET b = 2 * 3.5 WHERE a > 1 + 1;
             QUERY PLAN
-------------------------------------
 Update on public.t_ex
   Set: b = 7
   ->  Filter: (a > 2)
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN SELECT a FROM t_ex WHERE 1 = 1 AND a > 0;
             QUERY PLAN
-------------------------------------
 Project
   Output: a
   ->  Filter: (a > 0)
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN SELECT a FROM t_ex WHERE a > 1 + NULL;
             QUERY PLAN
-------------------------------------
 Project
   Output: a
   ->  Filter: (a > NULL)
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN SELECT a FROM t_ex WHERE a = 1 / 0;
ERROR: 整型除零
-- 布尔化简: 单侧常量 bool 按支配/恒等规则化简, NULL 常量不可化简
EXPLAIN SELECT a FROM t_ex WHERE 1 = 2 AND a > 0;
     QUERY PLAN
--------------------
 Project
   Output: a
   ->  Empty Result
(3 行)
EXPLAIN SELECT a FROM t_ex WHERE a > 0 AND 2 > 3;
     QUERY PLAN
--------------------
 Project
   Output: a
   ->  Empty Result
(3 行)
EXPLAIN SELECT a FROM t_ex WHERE 1 = 1 OR a > 0;
          QUERY PLAN
-------------------------------
 Project
   Output: a
   ->  Seq Scan on public.t_ex
(3 行)
EXPLAIN SELECT a FROM t_ex WHERE 2 > 3 OR a > 0;
             QUERY PLAN
-------------------------------------
 Project
   Output: a
   ->  Filter: (a > 0)
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN SELECT a FROM t_ex WHERE NULL AND a > 0;
             QUERY PLAN
-------------------------------------
 Project
   Output: a
   ->  Filter: (NULL AND (a > 0))
         ->  Seq Scan on public.t_ex
(4 行)
-- NOT 消除: 双重否定/比较符取反/判空取反, 逻辑节点 NOT 与常量 NOT 不改写
EXPLAIN SELECT a FROM t_ex WHERE NOT (a = 1);
             QUERY PLAN
-------------------------------------
 Project
   Output: a
   ->  Filter: (a <> 1)
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN SELECT a FROM t_ex WHERE NOT (a <= 2);
             QUERY PLAN
-------------------------------------
 Project
   Output: a
   ->  Filter: (a > 2)
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN SELECT a FROM t_ex WHERE NOT NOT (a > 0);
             QUERY PLAN
-------------------------------------
 Project
   Output: a
   ->  Filter: (a > 0)
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN SELECT a FROM t_ex WHERE NOT (a IS NULL);
             QUERY PLAN
-------------------------------------
 Project
   Output: a
   ->  Filter: (a IS NOT NULL)
         ->  Seq Scan on public.t_ex
(4 行)
EXPLAIN SELECT a FROM t_ex WHERE NOT (a > 0 AND b > 1.5);
                 QUERY PLAN
---------------------------------------------
 Project
   Output: a
   ->  Filter: (NOT ((a > 0) AND (b > 1.5)))
         ->  Seq Scan on public.t_ex
(4 行)
-- 常量过滤器剪除: 恒真 Filter 摘除, 恒假/NULL 常量谓词整棵子树剪成空结果
EXPLAIN SELECT * FROM t_ex WHERE true;
          QUERY PLAN
-------------------------------
 Project
   Output: a, b, c
   ->  Seq Scan on public.t_ex
(3 行)
EXPLAIN SELECT * FROM t_ex WHERE false;
     QUERY PLAN
--------------------
 Project
   Output: a, b, c
   ->  Empty Result
(3 行)
EXPLAIN SELECT a FROM t_ex WHERE NULL;
     QUERY PLAN
--------------------
 Project
   Output: a
   ->  Empty Result
(3 行)
EXPLAIN DELETE FROM t_ex WHERE false;
      QUERY PLAN
-----------------------
 Delete on public.t_ex
   ->  Empty Result
(2 行)
EXPLAIN UPDATE t_ex SET b = 1.0 WHERE false;
      QUERY PLAN
-----------------------
 Update on public.t_ex
   Set: b = 1
   ->  Empty Result
(3 行)
