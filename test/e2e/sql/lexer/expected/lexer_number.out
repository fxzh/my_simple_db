-- 整数/浮点字面量: 边界内可用, 超范围报词法错误
CREATE TABLE t_ln (i bigint, d double);
CREATE
INSERT INTO t_ln VALUES (9223372036854775807, 1.5);
INSERT 1
INSERT INTO t_ln VALUES (0, .125);
INSERT 1
SELECT * FROM t_ln ORDER BY i;
          i          |   d
---------------------+-------
 0                   | 0.125
 9223372036854775807 | 1.5
(2 行)
SELECT 123. FROM t_ln;
 123
-----
 123
 123
(2 行)
SELECT 9223372036854775808 FROM t_ln;
ERROR: 1.8-26: integer literal out of range: 9223372036854775808
SELECT 99999999999999999999 FROM t_ln;
ERROR: 1.8-27: integer literal out of range: 99999999999999999999
INSERT INTO t_ln VALUES (99999999999999999999, 1.0);
ERROR: 1.26-45: integer literal out of range: 99999999999999999999
SELECT .0 FROM t_ln;
ERROR: 1.8-318: float literal out of range: .0
DROP TABLE t_ln;
DROP
