-- 整数/浮点字面量: 边界内可用, 超范围报错
CREATE TABLE t_ln (i bigint, d double);
CREATE
INSERT INTO t_ln VALUES (9223372036854775807, 1.5);
INSERT 1
INSERT INTO t_ln VALUES (0, .125);
INSERT 1
SELECT * FROM t_ln ORDER BY i;
          i          |   d
---------------------+-------
 0                   | 0.125
 9223372036854775807 | 1.5
(2 行)
SELECT 123. FROM t_ln;
 123.
------
 123
 123
(2 行)
SELECT 9223372036854775808 FROM t_ln;
ERROR: 整数字面量超出可表示范围
SELECT 99999999999999999999 FROM t_ln;
ERROR: 整数字面量超出可表示范围
INSERT INTO t_ln VALUES (99999999999999999999, 1.0);
ERROR: 整数字面量超出可表示范围
SELECT .0 FROM t_ln;
ERROR: 浮点字面量超出可表示范围
-- 科学计数法: 整数/小数尾数与正负指数, 超范围报错
INSERT INTO t_ln VALUES (1, 1e5);
INSERT 1
INSERT INTO t_ln VALUES (2, 1.5E-3);
INSERT 1
INSERT INTO t_ln VALUES (3, .5e+2);
INSERT 1
INSERT INTO t_ln VALUES (4, 2.e3);
INSERT 1
SELECT * FROM t_ln WHERE i <= 4 ORDER BY i;
 i |   d
---+--------
 0 | 0.125
 1 | 1e+05
 2 | 0.0015
 3 | 50
 4 | 2000
(5 行)
SELECT 1e5 + .25e+1 FROM t_ln;
 (1e5 + .25e+1)
----------------
 100002.5
 100002.5
 100002.5
 100002.5
 100002.5
 100002.5
(6 行)
SELECT 3e308 FROM t_ln;
ERROR: 浮点字面量超出可表示范围
SELECT 1e-400 FROM t_ln;
ERROR: 浮点字面量超出可表示范围
DROP TABLE t_ln;
DROP
