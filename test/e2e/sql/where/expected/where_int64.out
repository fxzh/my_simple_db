-- bigint 2^53 附近纯整型比较须精确, 不经 double 提升
CREATE TABLE t_wb (v BIGINT);
CREATE
INSERT INTO t_wb VALUES (9007199254740992);
INSERT 1
INSERT INTO t_wb VALUES (9007199254740993);
INSERT 1
SELECT v FROM t_wb WHERE v = 9007199254740993;
        v
------------------
 9007199254740993
(1 行)
SELECT v FROM t_wb WHERE v = 9007199254740992;
        v
------------------
 9007199254740992
(1 行)
SELECT v FROM t_wb WHERE v > 9007199254740992;
        v
------------------
 9007199254740993
(1 行)
SELECT v FROM t_wb WHERE v < 9007199254740993;
        v
------------------
 9007199254740992
(1 行)
SELECT v FROM t_wb WHERE v <> 9007199254740993;
        v
------------------
 9007199254740992
(1 行)
-- 负值对称
INSERT INTO t_wb VALUES (-9007199254740993);
INSERT 1
SELECT v FROM t_wb WHERE v = -9007199254740993;
         v
-------------------
 -9007199254740993
(1 行)
-- 混合 double 比较按浮点提升语义, 2^53+1 舍入为 2^53 两行均命中
SELECT v FROM t_wb WHERE v = 9007199254740993.0;
        v
------------------
 9007199254740992
 9007199254740993
(2 行)
-- 纯整型常量谓词折叠比较
SELECT v FROM t_wb WHERE 9007199254740992 = 9007199254740993;
 v
(0 行)
SELECT v FROM t_wb WHERE 9007199254740992 < 9007199254740993;
         v
-------------------
 9007199254740992
 9007199254740993
 -9007199254740993
(3 行)
-- DELETE 谓词精确命中
DELETE FROM t_wb WHERE v = 9007199254740993;
DELETE 1
SELECT v FROM t_wb;
         v
-------------------
 9007199254740992
 -9007199254740993
(2 行)
DROP TABLE t_wb;
DROP
