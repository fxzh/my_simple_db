(2 行)
-- 布尔化简: 常量侧化简后被支配侧不再求值(除零不报错)
SELECT id FROM t_w WHERE 1 = 1 AND score > 60;
 id
----
 1
 3
(2 行)
SELECT id FROM t_w WHERE 1 = 2 AND score > 60;
 id
