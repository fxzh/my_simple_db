CREATE TABLE t_si (a int, b bigint, c double, f float, s char(3), v varchar(5));
CREATE
INSERT INTO t_si VALUES ('x', 1, 1.0, 1.0, 'a', 'a');
ERROR: 值与列类型不匹配
INSERT INTO t_si VALUES (1.5, 1, 1.0, 1.0, 'a', 'a');
ERROR: 值与列类型不匹配
INSERT INTO t_si VALUES (2147483648, 1, 1.0, 1.0, 'a', 'a');
ERROR: 整型值超出 int 可表示范围
INSERT INTO t_si VALUES (1, 'x', 1.0, 1.0, 'a', 'a');
ERROR: 值与列类型不匹配
INSERT INTO t_si VALUES (1, 1, 'x', 1.0, 'a', 'a');
ERROR: 值与列类型不匹配
INSERT INTO t_si VALUES (1, 1, 1.0, 'x', 'a', 'a');
ERROR: 值与列类型不匹配
INSERT INTO t_si VALUES (1, 1, 1, 1.0, 'a', 'a');
INSERT 1
INSERT INTO t_si VALUES (1, 1, 1.0, 1.0, 'abcd', 'a');
ERROR: 值与列类型不匹配
INSERT INTO t_si VALUES (1, 1, 1.0, 1.0, 'a', 'abcdef');
ERROR: 值与列类型不匹配
INSERT INTO t_si VALUES (1, 2);
ERROR: 值的数量与列数不符
INSERT INTO t_si VALUES (1 > 2, 1, 1.0, 1.0, 'a', 'a');
ERROR: 值与列类型不匹配
INSERT INTO t_si VALUES (NULL, 1, 1.0, 1.0, 'a', 'a');
INSERT 1
INSERT INTO t_si VALUES (a, 1, 1.0, 1.0, 'a', 'a');
ERROR: 常量上下文不允许引用列: a
INSERT INTO nosuch_si VALUES (1);
ERROR: 表不存在: public.nosuch_si
INSERT INTO t_si VALUES (1, 2, 3.0, 4.0, 'ab', 'abcde');
INSERT 1
SELECT * FROM t_si ORDER BY a, b;
  a   | b | c | f |  s  |   v
------+---+---+---+-----+-------
 1    | 1 | 1 | 1 | a   | a
 1    | 2 | 3 | 4 | ab  | abcde
 NULL | 1 | 1 | 1 | a   | a
(3 行)
DROP TABLE t_si;
DROP
-- 函数实参与列类型检查
CREATE TABLE t_sif (i int, s char(3));
CREATE
INSERT INTO t_sif VALUES (abs('x'));
ERROR: 函数实参个数或类型不符: abs
INSERT INTO t_sif (s) VALUES (abs(1));
ERROR: 值与列类型不匹配
DROP TABLE t_sif;
DROP
CREATE TABLE t_ic (a int, b double, s varchar);
CREATE
INSERT INTO t_ic (nosuch) VALUES (1);
ERROR: 列不存在: nosuch
INSERT INTO t_ic (a, a) VALUES (1, 2);
ERROR: 插入列清单中列重复: a
INSERT INTO t_ic (a, b) VALUES (1);
ERROR: 值的数量与列数不符
INSERT INTO t_ic (a, b) VALUES (1, 2, 3);
ERROR: 值的数量与列数不符
INSERT INTO t_ic (a) VALUES ('x');
ERROR: 值与列类型不匹配
INSERT INTO t_ic (b, a) VALUES ('x', 1);
ERROR: 值与列类型不匹配
INSERT INTO t_ic (b) VALUES (1 > 2);
ERROR: 值与列类型不匹配
INSERT INTO t_ic (a) VALUES (b);
ERROR: 常量上下文不允许引用列: b
INSERT INTO t_ic (a, s) VALUES (NULL, 'ok');
INSERT 1
SELECT * FROM t_ic;
  a   |  b   | s
------+------+----
 NULL | NULL | ok
(1 行)
DROP TABLE t_ic;
DROP
CREATE TABLE t_sn (a int NOT NULL, b int, s varchar(4) not null);
CREATE
INSERT INTO t_sn VALUES (1, NULL, 'x');
INSERT 1
INSERT INTO t_sn VALUES (NULL, 1, 'x');
ERROR: NOT NULL 列不允许 NULL: a
INSERT INTO t_sn (b) VALUES (1);
ERROR: NOT NULL 列不允许 NULL: a
INSERT INTO t_sn (a, s) VALUES (1, NULL);
ERROR: NOT NULL 列不允许 NULL: s
INSERT INTO t_sn VALUES (1, 2);
ERROR: 值的数量与列数不符
INSERT INTO t_sn VALUES (2, NULL, 'y'), (NULL, 3, 'z');
ERROR: NOT NULL 列不允许 NULL: a
INSERT INTO t_sn VALUES (3, 4, 'ok'), (5, 6, 'no');
INSERT 2
SELECT * FROM t_sn ORDER BY a;
 a |  b   | s
---+------+----
 1 | NULL | x
 3 | 4    | ok
 5 | 6    | no
(3 行)
DROP TABLE t_sn;
DROP
-- 三值逻辑的实际非空结果可写入 NOT NULL 列
CREATE TABLE t_null_insert (id int, i int, n numeric, np numeric(6,2), flag boolean NOT NULL);
CREATE
SELECT false AND NULL, NULL AND false, true OR NULL, NULL OR true;
 (false AND NULL) | (NULL AND false) | (true OR NULL) | (NULL OR true)
------------------+------------------+----------------+----------------
 false            | false            | true           | true
(1 行)
INSERT INTO t_null_insert (id, flag) VALUES (1, false AND NULL), (2, true OR NULL);
INSERT 2
INSERT INTO t_null_insert (id, flag) VALUES (3, NULL AND false), (4, NULL OR true);
INSERT 2
INSERT INTO t_null_insert (id, flag) VALUES (5, NOT (false AND NULL));
INSERT 1
INSERT INTO t_null_insert (id, flag) VALUES (6, 2 BETWEEN 3 AND NULL);
INSERT 1
INSERT INTO t_null_insert (id, flag) VALUES (7, CAST(true OR NULL AS boolean));
INSERT 1
-- 实际 NULL 结果拒绝写入 NOT NULL 列，多行写入整体回滚
INSERT INTO t_null_insert (id, flag) VALUES (8, true AND NULL);
ERROR: NOT NULL 列不允许 NULL: flag
INSERT INTO t_null_insert (id, flag) VALUES (8, false OR NULL);
ERROR: NOT NULL 列不允许 NULL: flag
INSERT INTO t_null_insert (id, flag) VALUES (8, CAST(NULL AS boolean));
ERROR: NOT NULL 列不允许 NULL: flag
INSERT INTO t_null_insert (id, flag) VALUES (8, true), (9, NULL OR false);
ERROR: NOT NULL 列不允许 NULL: flag
-- 可空表达式仍按静态类型检查赋值兼容性
INSERT INTO t_null_insert (i, flag) VALUES (true OR NULL, false);
ERROR: 值与列类型不匹配
INSERT INTO t_null_insert (i, flag) VALUES (false AND NULL, false);
ERROR: 值与列类型不匹配
INSERT INTO t_null_insert (i, flag) VALUES (true AND NULL, false);
ERROR: 值与列类型不匹配
INSERT INTO t_null_insert (i, flag) VALUES (CAST(NULL AS boolean), false);
ERROR: 值与列类型不匹配
INSERT INTO t_null_insert (i, flag) VALUES (CAST(NULL AS varchar), false);
ERROR: 值与列类型不匹配
INSERT INTO t_null_insert (n, flag) VALUES (true OR NULL, false);
ERROR: 值与列类型不匹配
INSERT INTO t_null_insert (np, flag) VALUES (true OR NULL, false);
ERROR: 值与列类型不匹配
INSERT INTO t_null_insert (n, flag) VALUES (CAST(NULL AS boolean), false);
ERROR: 值与列类型不匹配
INSERT INTO t_null_insert (np, flag) VALUES (CAST(NULL AS boolean), false);
ERROR: 值与列类型不匹配
INSERT INTO t_null_insert (flag) VALUES (1 + NULL);
ERROR: 值与列类型不匹配
-- 裸 NULL 与赋值兼容的有类型 NULL 可写入可空列
INSERT INTO t_null_insert VALUES (8, NULL, NULL, NULL, false);
INSERT 1
INSERT INTO t_null_insert VALUES (9, CAST(NULL AS int), CAST(NULL AS int), CAST(NULL AS numeric), true);
INSERT 1
SELECT * FROM t_null_insert ORDER BY id;
 id |  i   |  n   |  np  | flag
----+------+------+------+-------
 1  | NULL | NULL | NULL | false
 2  | NULL | NULL | NULL | true
 3  | NULL | NULL | NULL | false
 4  | NULL | NULL | NULL | true
 5  | NULL | NULL | NULL | true
 6  | NULL | NULL | NULL | false
 7  | NULL | NULL | NULL | true
 8  | NULL | NULL | NULL | false
 9  | NULL | NULL | NULL | true
(9 行)
DROP TABLE t_null_insert;
DROP
