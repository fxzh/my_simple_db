SELECT i FROM t_ss WHERE i > s;
ERROR: 比较运算两侧须同为数值或字符串
SELECT i > 1 FROM t_ss;
ERROR: 布尔值不可作为存储或输出值
SELECT i FROM t_ss WHERE nosuch_ss;
