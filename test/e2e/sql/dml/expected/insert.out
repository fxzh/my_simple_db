CREATE TABLE t_multi (id int, name varchar, score double);
CREATE
INSERT INTO t_multi VALUES (1, 'alice', 90.5), (2, 'bob', 60.0), (3, 'carol', 75.5);
INSERT 3
INSERT INTO t_multi VALUES (4, 'dave', NULL), (NULL, NULL, NULL);
INSERT 2
