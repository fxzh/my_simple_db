CREATE TABLE t_err (id int, v varchar);
CREATE
BEGIN;
BEGIN
INSERT INTO t_err VALUES (1, 'a');
INSERT 1
INSERT INTO t_err VALUES (2, 'b');
INSERT 1
INSERT INTO t_err VALUES (1 / 0, 'c');
ERROR: 整型除零, 事务已回滚
SELECT * FROM t_err;
 id | v
(0 行)
COMMIT;
ERROR: COMMIT: 无活动事务
