-- db_type 元数据表: 类型种子行全量可见(名称/别名与声明属性列)
SELECT * FROM system.db_type ORDER BY type_id;
 type_id | type_name |  alias  | family | rank | len_allowed | len_default | len_max | scale_allowed | rep | store | width
---------+-----------+---------+--------+------+-------------+-------------+---------+---------------+-----+-------+-------
 1       | int       | NULL    | 1      | 1    | 0           | 0           | 0       | 0             | 1   | 1     | 4
 2       | bigint    | NULL    | 1      | 2    | 0           | 0           | 0       | 0             | 1   | 1     | 8
 3       | double    | NULL    | 1      | 5    | 0           | 0           | 0       | 0             | 3   | 1     | 8
 4       | varchar   | NULL    | 2      | 0    | 1           | 0           | 65535   | 0             | 4   | 3     | 0
 5       | float     | NULL    | 1      | 4    | 0           | 0           | 0       | 0             | 2   | 1     | 4
 6       | char      | NULL    | 2      | 0    | 1           | 1           | 65535   | 0             | 4   | 2     | 0
 7       | boolean   | bool    | 3      | 0    | 0           | 0           | 0       | 0             | 5   | 1     | 1
 8       | numeric   | decimal | 1      | 3    | 1           | 0           | 38      | 1             | 6   | 4     | 0
(8 行)
