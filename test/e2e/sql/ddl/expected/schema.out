-- create/drop schema 生命周期与重名/保护行为
CREATE SCHEMA s_test;
CREATE
CREATE SCHEMA s_test;
ERROR: schema 已存在: s_test
SELECT schema_name FROM system.db_schema;
 schema_name
-------------
 system
 public
 s_test
(3 行)
DROP SCHEMA system;
ERROR: schema 非空禁止删除: system
DROP SCHEMA s_test;
DROP
DROP SCHEMA s_test;
ERROR: schema 不存在: s_test
-- 限定名建表挂所属 schema, 未限定名默认挂 current_schema(public), 表名 schema 内唯一
CREATE SCHEMA s_q;
CREATE
CREATE TABLE s_q.t_q (id int not null, name varchar(8));
CREATE
CREATE TABLE s_q.t_q (id int not null, name varchar(8));
ERROR: 表已存在: s_q.t_q
CREATE TABLE t_q (id int not null, name varchar(8));
CREATE
INSERT INTO s_q.t_q VALUES (1, 'a'), (2, 'b');
INSERT 2
INSERT INTO t_q VALUES (9, 'z');
INSERT 1
UPDATE s_q.t_q SET name = 'x' WHERE id = 1;
UPDATE 1
DELETE FROM s_q.t_q WHERE id = 2;
DELETE 1
SELECT * FROM s_q.t_q;
 id | name
----+------
 1  | x
(1 行)
SELECT * FROM t_q;
 id | name
----+------
 9  | z
(1 行)
SELECT * FROM public.t_q;
 id | name
----+------
 9  | z
(1 行)
SELECT * FROM system.t_q;
ERROR: 表不存在: system.t_q
DROP SCHEMA s_q;
ERROR: schema 非空禁止删除: s_q
DROP TABLE s_q.t_q;
DROP
DROP TABLE t_q;
DROP
DROP SCHEMA s_q;
DROP
-- 未限定名解析到 current_schema, schema 不存在当场报错
CREATE SCHEMA s_u;
CREATE
CREATE TABLE s_u.t_u (id int);
CREATE
SELECT * FROM t_u;
ERROR: 表不存在: public.t_u
SELECT * FROM no_such.t_u;
ERROR: schema 不存在: no_such
CREATE TABLE no_such.t_u (id int);
ERROR: schema 不存在: no_such
DROP TABLE no_such.t_u;
ERROR: schema 不存在: no_such
DROP TABLE s_u.t_u;
DROP
DROP SCHEMA s_u;
DROP
-- 保留表拦截仅限 system 名下
CREATE SCHEMA s_r;
CREATE
CREATE TABLE s_r.db_table (id int);
CREATE
INSERT INTO s_r.db_table VALUES (1);
INSERT 1
SELECT * FROM s_r.db_table;
 id
----
 1
(1 行)
DROP TABLE system.db_table;
ERROR: 保留表名禁止使用: system.db_table
DROP TABLE s_r.db_table;
DROP
DROP SCHEMA s_r;
DROP
-- current_schema 切换: 允许切向不存在的 schema, 未限定名随之后解析
SET current_schema = s_u;
SET
CREATE TABLE t_cs (id int);
ERROR: schema 不存在: s_u
CREATE SCHEMA s_cs;
CREATE
SET current_schema = s_cs;
SET
CREATE TABLE t_cs (id int);
CREATE
INSERT INTO t_cs VALUES (1);
INSERT 1
SELECT * FROM t_cs;
 id
----
 1
(1 行)
SET current_schema = public;
SET
DROP TABLE t_cs;
ERROR: 表不存在: public.t_cs
DROP TABLE s_cs.t_cs;
DROP
DROP SCHEMA s_cs;
DROP
-- public 可删除, 删除后未限定名报 schema 不存在, 重建后恢复
DROP SCHEMA public;
DROP
CREATE TABLE t_p (id int);
ERROR: schema 不存在: public
CREATE SCHEMA public;
CREATE
CREATE TABLE t_p (id int);
CREATE
INSERT INTO t_p VALUES (1);
INSERT 1
SELECT * FROM t_p;
 id
----
 1
(1 行)
DROP TABLE t_p;
DROP
